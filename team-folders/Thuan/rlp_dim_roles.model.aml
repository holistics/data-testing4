Model rlp_dim_roles {
  type: 'query'
  label: 'RLP Dim Roles'
  description: 'Stand-in for teveo dim_countries (CF-13963). Uses h_role values instead of country names so permissions are easy to verify.'
  data_source_name: 'demodb'

  query: @sql
    select 1 as id, 'admin' as role_name
    union all
    select 2 as id, 'analyst' as role_name
    union all
    select 3 as id, 'viewer' as role_name
  ;;

  dimension id {
    label: 'Id'
    type: 'number'
    primary_key: true
    definition: @sql {{ #SOURCE.id }} ;;
  }

  dimension role_name {
    label: 'Role Name'
    type: 'text'
    definition: @sql {{ #SOURCE.role_name }} ;;
  }
}
