Model rlp_fct_sales {
  type: 'query'
  label: 'RLP Fct Sales'
  description: '''
    Stand-in for teveo fct_sales (CF-13963).
    Covers the 4 combinations of (destination role, influencer target role) so the OR-rule can be verified:
    - sale 1: admin   / admin   -> visible to an admin manager (both sides match)
    - sale 2: admin   / analyst -> visible to an admin manager (destination only)
    - sale 3: analyst / admin   -> visible to an admin manager (influencer only)
    - sale 4: analyst / analyst -> hidden from an admin manager
  '''
  data_source_name: 'demodb'

  query: @sql
    with sales as (
      select 1 as id, 1 as role_id, 1 as influencer_id, 100 as amount
      union all
      select 2 as id, 1 as role_id, 2 as influencer_id, 200 as amount
      union all
      select 3 as id, 2 as role_id, 1 as influencer_id, 300 as amount
      union all
      select 4 as id, 2 as role_id, 2 as influencer_id, 400 as amount
      union all
      select 5 as id, 3 as role_id, 2 as influencer_id, 500 as amount
    ),
    roles as (
      select 1 as id, 'admin' as role_name
      union all
      select 2 as id, 'analyst' as role_name
      union all
      select 3 as id, 'viewer' as role_name
    ),
    influencers as (
      select 1 as id, 'Influencer Admin' as name, 'admin' as target_role
      union all
      select 2 as id, 'Influencer Analyst' as name, 'analyst' as target_role
      union all
      select 3 as id, 'Influencer Viewer' as name, 'viewer' as target_role
    )
    select
      s.id,
      s.role_id,
      s.influencer_id,
      s.amount,
      r.role_name as destination_role,
      i.target_role as influencer_target_role,
      i.name as influencer_name
    from sales s
    left join roles r on s.role_id = r.id
    left join influencers i on s.influencer_id = i.id
  ;;

  dimension id {
    label: 'Id'
    type: 'number'
    primary_key: true
    definition: @sql {{ #SOURCE.id }} ;;
  }

  dimension role_id {
    label: 'Role Id'
    type: 'number'
    definition: @sql {{ #SOURCE.role_id }} ;;
  }

  dimension influencer_id {
    label: 'Influencer Id'
    type: 'number'
    definition: @sql {{ #SOURCE.influencer_id }} ;;
  }

  dimension amount {
    label: 'Amount'
    type: 'number'
    definition: @sql {{ #SOURCE.amount }} ;;
  }

  dimension destination_role {
    label: 'Destination Role'
    type: 'text'
    definition: @sql {{ #SOURCE.destination_role }} ;;
  }

  dimension influencer_target_role {
    label: 'Influencer Target Role'
    type: 'text'
    definition: @sql {{ #SOURCE.influencer_target_role }} ;;
  }

  dimension influencer_name {
    label: 'Influencer Name'
    description: '''
      Column-level permission (redaction), not row filtering. Influencers outside the current user role come
      back as '(redacted)'. This is what lets the sales dataset expose influencer identity without needing the
      influencer dim model in the dataset at all - so there is no un-ruled model for a user to query directly.
      Redaction is applied in the field definition, so it holds no matter how the field is reached.
    '''
    type: 'text'
    definition: @sql
      case
        when {{ #SOURCE.influencer_target_role }} = '${H.current_user.h_role}'
          then {{ #SOURCE.influencer_name }}
        else '(redacted)'
      end
    ;;
  }

  dimension has_role_access {
    label: 'Has Role Access'
    description: '''
      The OR lives inside the field, and the user attribute is baked in, so the RLP rule is a plain `is true`.
      No concat/contains needed: both roles are real columns here, so this is an exact equality match
      (immune to the Congo / DR Congo substring problem).
    '''
    type: 'truefalse'
    hidden: true
    definition: @sql
      {{ #SOURCE.destination_role }} = '${H.current_user.h_role}'
      OR {{ #SOURCE.influencer_target_role }} = '${H.current_user.h_role}'
    ;;
  }

  measure total_amount {
    label: 'Total Amount'
    type: 'number'
    definition: @aql sum(rlp_fct_sales.amount) ;;
  }
}
