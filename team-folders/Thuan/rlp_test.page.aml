Dashboard rlp_test {
  title: 'RLP Test (CF-13963)'
  description: '''
    Test surface for the teveo OR-rule reproduction. View this while impersonating an Explorer
    (top-right menu -> View and Edit as) with h_role = admin, then h_role = analyst.

    Expected with h_role = admin:
    - Sales: ids 1, 2, 3. Sale 3 has destination_role = analyst and SHOULD be visible (its influencer
      targets admin) - that is the OR working, not a leak. Ids 4 and 5 must disappear.
    - Influencer Directory: influencer 1 only.

    Expected with h_role = analyst:
    - Sales: ids 2, 3, 4, 5.
    - Influencer Directory: influencer 2 only.

    RLP as code is NOT enforced in the Development workspace - publish to production before testing.
  '''

  view: CanvasLayout {
    label: 'View 1'
    height: 900
    block sales_table {
      position: pos(40, 40, 900, 380)
    }
    block influencers_table {
      position: pos(40, 450, 900, 320)
    }
  }

  block sales_table: VizBlock {
    label: 'Sales visible to me'
    viz: DataTable {
      dataset: rlp_sales_dataset
      fields: [
        VizFieldFull {
          ref: ref('rlp_fct_sales', 'id')
          format {
            type: 'number'
          }
        },
        VizFieldFull {
          ref: ref('rlp_fct_sales', 'destination_role')
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: ref('rlp_fct_sales', 'influencer_target_role')
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: ref('rlp_fct_sales', 'influencer_name')
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: ref('rlp_fct_sales', 'total_amount')
          format {
            type: 'number'
          }
        }
      ]
      settings {
        pagination_size: 50
      }
    }
  }

  block influencers_table: VizBlock {
    label: 'Influencer Directory (separate dataset)'
    viz: DataTable {
      dataset: rlp_influencers_dataset
      fields: [
        VizFieldFull {
          ref: ref('rlp_dim_influencers', 'id')
          format {
            type: 'number'
          }
        },
        VizFieldFull {
          ref: ref('rlp_dim_influencers', 'name')
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: ref('rlp_dim_influencers', 'target_role')
          format {
            type: 'text'
          }
        }
      ]
      settings {
        pagination_size: 50
      }
    }
  }
}
