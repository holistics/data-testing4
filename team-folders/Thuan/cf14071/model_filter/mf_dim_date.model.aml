Model mf_dim_date {
  type: 'query'
  label: 'MF Dim Date'
  data_source_name: 'demodb'

  query: @sql
    select 20260101 as date_key, date '2026-01-01' as date_value
    union all
    select 20260102 as date_key, date '2026-01-02' as date_value
  ;;

  dimension date_key {
    label: 'Date Key'
    type: 'number'
    primary_key: true
    definition: @sql {{ #SOURCE.date_key }} ;;
  }

  dimension date_value {
    label: 'Date'
    type: 'date'
    definition: @sql {{ #SOURCE.date_value }} ;;
  }
}
