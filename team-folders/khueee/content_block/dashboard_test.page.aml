Dashboard dashboard_test {
  title: 'dashboard_test'
  description: ''
  owner: 'khue.pm@holistics.io'
  block title: TextBlock {
    content: @md Product Report - Conversion Rate 
;;
  }
  block product_conversion_performance: VizBlock {
    label: 'Product Conversion Performance'
    viz: MarkdownViz {
      dataset: data_dumbbell_dataset
      rows: [
        VizFieldFull {
          label: 'Product Name'
          ref: r(data_dumbbell.product_name)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Added To Cart'
          ref: r(data_dumbbell.added_to_cart)
          format {
            type: 'number'
            pattern: '#,#0'
          }
        },
        VizFieldFull {
          label: 'Purchased'
          ref: r(data_dumbbell.purchased)
          format {
            type: 'number'
            pattern: '#,#0'
          }
        },
        VizFieldFull {
          label: 'Cart Abandonment'
          ref: r(data_dumbbell.cart_abandonment)
          format {
            type: 'number'
            pattern: '#,#0'
          }
        },
        VizFieldFull {
          label: 'Conversion Rate'
          ref: r(data_dumbbell.conversion_rate)
          format {
            type: 'number'
            pattern: '#,#0.0%'
          }
        },
        VizFieldFull {
          label: 'Start Percent'
          ref: r(data_dumbbell.start_percent)
          format {
            type: 'number'
            pattern: '#,###\\%'
            group_separator: ','
            decimal_separator: '.'
          }
        },
        VizFieldFull {
          label: 'End Percent'
          ref: r(data_dumbbell.end_percent)
          format {
            type: 'number'
            pattern: '#,###\\%'
            group_separator: ','
            decimal_separator: '.'
          }
        }
      ]
      content: @md <style>
  .product-conversion-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; max-height: 540px; overflow-y: auto; overscroll-behavior: contain; padding: 8px 12px 8px 8px; }
  .product-conversion-card { overflow: hidden; border: 1px solid #E5E7EB; border-radius: 14px; background: #FFFFFF; box-shadow: 0 1px 2px rgba(15,23,42,0.04), 0 4px 10px rgba(15,23,42,0.04); }
  .product-conversion-card-header { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 16px 18px; border-bottom: 1px solid #EEF2F6; background: #FAFBFC; }
  .product-conversion-card-title { margin: 0; color: #0F172A; font-size: 16px; font-weight: 700; line-height: 1.35; }
  .product-conversion-rate-pill { flex-shrink: 0; padding: 4px 10px; border-radius: 999px; background: #ECFDF5; color: #047857; font-size: 12px; font-weight: 700; white-space: nowrap; }
  .product-conversion-card-body { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; padding: 16px 18px 18px; }
  .product-conversion-metric { padding: 10px 12px; border-radius: 10px; background: #F8FAFC; border: 1px solid #F1F5F9; }
  .product-conversion-metric.abandonment { background: #FFF7ED; }
  .product-conversion-metric.abandonment .product-conversion-value { color: #B45309; }
  .product-conversion-label { color: #64748B; font-size: 11px; font-weight: 600; letter-spacing: 0.03em; text-transform: uppercase; }
  .product-conversion-value { margin-top: 4px; color: #0F172A; font-size: 17px; font-weight: 700; }
  .pagination-row.top { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 0 0 18px; padding: 10px 12px; border: 1px solid #BFDBFE; border-radius: 12px; background: #F8FBFF; box-shadow: 0 4px 12px rgba(15,23,42,0.10); }
  .pagination-label { color: #475569; font-size: 13px; font-weight: 700; }
  .pagination-actions { display: flex; align-items: center; gap: 8px; }
  h-pagination { display: inline-flex; align-items: center; justify-content: center; min-height: 34px; padding: 0 14px; border: 1px solid #BFDBFE; border-radius: 8px; background: #FFFFFF; color: #1D4ED8; font-size: 13px; font-weight: 700; cursor: pointer; }
  h-pagination:hover { background: #EFF6FF; border-color: #60A5FA; }
</style>
<div class="pagination-row top">
  <span class="pagination-label">Browse product cards</span>
  <div class="pagination-actions">
    <h-pagination type="previous">← Previous</h-pagination>
    <h-pagination type="next">Next →</h-pagination>
  </div>
</div>
<div class="product-conversion-cards">
{% map(rows) %}
  <article class="product-conversion-card">
    <header class="product-conversion-card-header"><h3 class="product-conversion-card-title">{{ `Product Name` }}</h3><span class="product-conversion-rate-pill">{{ `Conversion Rate` }}</span></header>
    <div class="product-conversion-card-body">
      <div class="product-conversion-metric"><div class="product-conversion-label">Added To Cart</div><div class="product-conversion-value">{{ `Added To Cart` }}</div></div>
      <div class="product-conversion-metric"><div class="product-conversion-label">Purchased</div><div class="product-conversion-value">{{ `Purchased` }}</div></div>
      <div class="product-conversion-metric abandonment"><div class="product-conversion-label">Cart Abandonment</div><div class="product-conversion-value">{{ `Cart Abandonment` }}</div></div>
      <div class="product-conversion-metric"><div class="product-conversion-label">Start Percent</div><div class="product-conversion-value">{{ `Start Percent` }}</div></div>
      <div class="product-conversion-metric" style="grid-column: span 2;"><div class="product-conversion-label">End Percent</div><div class="product-conversion-value">{{ `End Percent` }}</div></div>
    </div>
  </article>
{% end %}
</div> ;;
      settings {
        pagination_size: 10
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }

  view: CanvasLayout {
    label: 'View 1'
    width: 1300
    height: 780
    grid_size: 20
    auto_expand_vertically: true
    block title {
      position: pos(20, 20, 1240, 60)
    }
    block product_conversion_performance {
      position: pos(20, 80, 1264, 660)
    }
    mobile {
      mode: 'auto'
    }
  }
  theme: ai_1773979634521_3
  explicit_interactions: []
}