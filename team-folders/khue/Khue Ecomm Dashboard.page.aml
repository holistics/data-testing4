Dashboard khue_ecomm_dashboard {
  title: 'Khue Ecomm Dashboard'
  description: ''
  owner: 'khue.pm@holistics.io'
  block title: TextBlock {
    content: @md Sales Order Tracking Dashboard
;;
  }
  block v_8jkz: VizBlock {
    label: 'Total Sales '
    viz: DataTable {
      dataset: ecommerce_khue
      fields: [
        VizFieldFull {
          ref: r(ecommerce_khue.total_sales)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        show_row_number: true
        row_limit: 5000
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_1a84: VizBlock {
    label: 'Total Orders'
    viz: DataTable {
      dataset: ecommerce_khue
      fields: [
        VizFieldFull {
          ref: r(ecommerce_khue.total_orders)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        show_row_number: true
        row_limit: 5000
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_ikpj: VizBlock {
    label: 'Items Sold'
    viz: DataTable {
      dataset: ecommerce_khue
      fields: [
        VizFieldFull {
          ref: r(ecommerce_khue.items_sold)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        show_row_number: true
        row_limit: 5000
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_0e8a: VizBlock {
    label: 'Average Order Value'
    viz: DataTable {
      dataset: ecommerce_khue
      fields: [
        VizFieldFull {
          ref: r(ecommerce_khue.average_order_value)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        show_row_number: true
        row_limit: 5000
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_duuk: VizBlock {
    label: 'Sale by Categories'
    viz: BarChart {
      dataset: ecommerce_khue
      x_axis: VizFieldFull {
        ref: r(khue_ecommerce_categories.name)
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(ecommerce_khue.total_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        row_limit: 5000
        x_axis_show_null_datetime: false
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_88u0: VizBlock {
    label: 'Sale by City'
    viz: BarChart {
      dataset: ecommerce_khue
      x_axis: VizFieldFull {
        ref: r(khue_ecommerce_cities.name)
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(ecommerce_khue.total_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        row_limit: 5000
        x_axis_show_null_datetime: false
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_zexm: VizBlock {
    label: 'Sales Over Time'
    viz: LineChart {
      dataset: ecommerce_khue
      x_axis: VizFieldFull {
        ref: r(khue_ecommerce_orders.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(ecommerce_khue.total_sales)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        row_limit: 5000
        x_axis_show_null_datetime: false
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_ghid: VizBlock {
    label: 'Sales by Merchant City by Name'
    viz: BarChart {
      dataset: ecommerce_khue
      x_axis: VizFieldFull {
        ref: r(khue_ecommerce_cities.name)
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(ecommerce_khue.sales_by_merchant_city)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        row_limit: 5000
        x_axis_show_null_datetime: false
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_zlde: VizBlock {
    label: 'Year, Quarter and 3 more'
    viz: DataTable {
      dataset: ecommerce_khue
      fields: [
        VizFieldFull {
          ref: r(khue_date_dim.year)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(khue_date_dim.quarter)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(ecommerce_khue.order_created)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(ecommerce_khue.orders_delivered)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(ecommerce_khue.orders_cancelled)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        show_row_number: true
        row_limit: 5000
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }

  view: CanvasLayout {
    label: 'View 1'
    width: 1300
    height: 2140
    grid_size: 20
    auto_expand_vertically: true
    block title {
      position: pos(20, 20, 1260, 60)
    }
    block v_8jkz {
      position: pos(20, 100, 280, 100)
      layer: 1
    }
    block v_1a84 {
      position: pos(300, 100, 320, 100)
      layer: 2
    }
    block v_ikpj {
      position: pos(620, 100, 320, 100)
      layer: 3
    }
    block v_0e8a {
      position: pos(940, 100, 340, 100)
      layer: 4
    }
    block v_duuk {
      position: pos(20, 220, 600, 420)
      layer: 5
    }
    block v_88u0 {
      position: pos(640, 220, 620, 420)
      layer: 6
    }
    block v_zexm {
      position: pos(0, 660, 1300, 440)
      layer: 7
    }
    block v_ghid {
      position: pos(0, 1120, 1300, 560)
      layer: 8
    }
    block v_zlde {
      position: pos(20, 1700, 620, 420)
      layer: 9
    }
    mobile {
      mode: 'auto'
    }
  }
  theme: H.themes.metropolitan
  interactions: [
    FilterInteraction {
      from: 'v_8jkz'
      to: [
        CustomMapping {
          block: [
            'v_1a84',
            'v_0e8a',
            'v_88u0',
            'v_ghid'
          ]
          disabled: true
        }
      ]
    },
    FilterInteraction {
      from: 'v_1a84'
      to: [
        CustomMapping {
          block: [
            'v_8jkz',
            'v_0e8a',
            'v_88u0',
            'v_ghid'
          ]
          disabled: true
        }
      ]
    },
    FilterInteraction {
      from: 'v_ikpj'
      to: [
        CustomMapping {
          block: [
            'v_0e8a',
            'v_88u0',
            'v_ghid'
          ]
          disabled: true
        }
      ]
    },
    FilterInteraction {
      from: 'v_0e8a'
      to: [
        CustomMapping {
          block: [
            'v_8jkz',
            'v_1a84',
            'v_ikpj',
            'v_88u0',
            'v_ghid'
          ]
          disabled: true
        }
      ]
    },
    FilterInteraction {
      from: 'v_duuk'
      to: [
        CustomMapping {
          block: [
            'v_88u0',
            'v_ghid'
          ]
          disabled: true
        }
      ]
    },
    FilterInteraction {
      from: 'v_88u0'
      to: [
        CustomMapping {
          block: [
            'v_8jkz',
            'v_1a84',
            'v_ikpj',
            'v_0e8a',
            'v_duuk',
            'v_ghid'
          ]
          disabled: true
        }
      ]
    },
    FilterInteraction {
      from: 'v_zexm'
      to: [
        CustomMapping {
          block: 'v_ghid'
          disabled: true
        }
      ]
    },
    FilterInteraction {
      from: 'v_ghid'
      to: [
        CustomMapping {
          block: [
            'v_8jkz',
            'v_1a84',
            'v_ikpj',
            'v_0e8a',
            'v_duuk',
            'v_88u0',
            'v_zexm'
          ]
          disabled: true
        }
      ]
    }
  ]
}