Dataset ecommerce_khue {
  label: 'ecommerce_khue'
  description: ''
  data_source_name: 'demodb'
  models: [
    khue_ecommerce_categories,
    khue_ecommerce_users,
    khue_ecommerce_products,
    khue_ecommerce_orders,
    khue_ecommerce_order_items,
    khue_ecommerce_merchants,
    khue_ecommerce_fct_inventory,
    khue_ecommerce_countries,
    khue_ecommerce_cities
    ,
    khue_date_dim
  ]
  relationships: [
    relationship(khue_ecommerce_cities.country_code > khue_ecommerce_countries.code, true),
    relationship(khue_ecommerce_users.city_id > khue_ecommerce_cities.id, true),
    relationship(khue_ecommerce_products.merchant_id > khue_ecommerce_merchants.id, true),
    relationship(khue_ecommerce_orders.user_id > khue_ecommerce_users.id, true),
    relationship(khue_ecommerce_order_items.order_id > khue_ecommerce_orders.id, true),
    relationship(khue_ecommerce_fct_inventory.product_id > khue_ecommerce_products.id, true),
    relationship(khue_ecommerce_products.category_id > khue_ecommerce_categories.id, true),
    relationship(khue_ecommerce_order_items.product_id > khue_ecommerce_products.id, true)
    ,
    relationship(khue_ecommerce_merchants.city_id > khue_ecommerce_cities.id, false)
    ,
    relationship(khue_ecommerce_orders.created_date > khue_date_dim.date, true)
    ,
    relationship(khue_ecommerce_users.sign_up_date > khue_date_dim.date, false)
    ,
    relationship(khue_ecommerce_orders.delivered_at > khue_date_dim.date, false),
    relationship(khue_ecommerce_orders.cancelled_at > khue_date_dim.date, false)
    ,
  ]
  dimension acquisition_month_cohort {
  model: khue_ecommerce_users
  label: 'Acquisition Month Cohort'
  type: 'date'

  definition: @aql
    min(khue_ecommerce_orders.created_at | month())
    | dimensionalize(khue_ecommerce_users.id)
  ;;
}
metric cohort_customers {
  label: 'Cohort Customers'
  type: 'number'

  definition: @aql
    count_distinct(khue_ecommerce_users.id)
  ;;
}
dimension month_number {
  model: khue_ecommerce_orders
  label: 'Month Number'
  type: 'number'

  definition: @aql
    date_diff(
      'month',
      khue_ecommerce_users.acquisition_month_cohort,
      khue_ecommerce_orders.created_at | month()
    )
  ;;
}
metric retention_rate {
  label: 'Retention Rate'
  type: 'number'

  definition: @aql
    safe_divide(
      cohort_customers,
      cohort_customers
        | of_all(khue_ecommerce_orders.month_number)
    )
  ;;
}
  metric total_sales {
    label: "Total Sales "
    type: "number"
    description: ""
    definition: @aql sum(
  khue_ecommerce_order_items,
  khue_ecommerce_order_items.quantity * khue_ecommerce_products.price
);;
    format: "[\$\$]#,###"
  }
  metric total_orders {
    label: "Total Orders"
    type: "number"
    description: ""
    definition: @aql count_distinct(khue_ecommerce_orders.id);;
    format: "none"
  }
  metric items_sold {
    label: "Items Sold"
    type: "number"
    description: ""
    definition: @aql sum(khue_ecommerce_order_items.quantity);;
    format: "none"
  }
  metric average_order_value {
    label: "Average Order Value"
    type: "number"
    description: ""
    definition: @aql sum(
  khue_ecommerce_order_items,
  khue_ecommerce_order_items.quantity * khue_ecommerce_products.price
) * 1.0
/
count_distinct(khue_ecommerce_orders.id);;
    format: "none"
  }
  metric sales_by_merchant_city {
    label: "Sales by Merchant City"
    type: "number"
    description: ""
    definition: @aql sum(
  khue_ecommerce_order_items,
  khue_ecommerce_order_items.quantity * khue_ecommerce_products.price
)
| with_relationships(
    khue_ecommerce_merchants.city_id > khue_ecommerce_cities.id
  );;
    format: "[\$\$]#,###"
  }
  metric order_created {
    label: "Order Created "
    type: "number"
    hidden: false
    description: ""
    definition: @aql count_distinct(khue_ecommerce_orders.id)
| where(khue_ecommerce_orders.created_date is not null);;
    format: "#,###"
  }
  metric orders_delivered {
    label: "Orders Delivered "
    type: "number"
    hidden: false
    description: ""
    definition: @aql count_distinct(khue_ecommerce_orders.id)
| where(khue_ecommerce_orders.delivered_at is not null)
| with_relationships(
    khue_ecommerce_orders.delivered_at > khue_date_dim.date
  );;
    format: "#,###"
  }
  metric orders_cancelled {
    label: "Orders Cancelled "
    type: "number"
    hidden: false
    description: ""
    definition: @aql count_distinct(khue_ecommerce_orders.id)
| where(khue_ecommerce_orders.cancelled_at is not null)
| with_relationships(
    khue_ecommerce_orders.cancelled_at > khue_date_dim.date
  );;
    format: "#,###"
  }
  metric total_revenue {
    label: "Total Revenue "
    type: "number"
    hidden: false
    description: ""
    definition: @aql sum(
  khue_ecommerce_order_items,
  khue_ecommerce_order_items.quantity * khue_ecommerce_products.price
)
| where(khue_ecommerce_orders.status == 'delivered');;
    format: "[\$\$]#,###"
  }
  metric average_order_value_01 {
    label: "Average Order Value "
    type: "number"
    hidden: false
    description: ""
    definition: @aql safe_divide(
  (
    sum(
      khue_ecommerce_order_items,
      khue_ecommerce_order_items.quantity * khue_ecommerce_products.price
    )
    | where(khue_ecommerce_orders.status == 'completed')
  ),
  (
    count_distinct(khue_ecommerce_orders.id)
    | where(khue_ecommerce_orders.status == 'completed')
  )
);;
    format: "[\$\$]#,###"
  }
  metric gross_margin {
    label: "Gross Margin"
    type: "number"
    description: ""
    definition: @aql safe_divide(
  (
    (
      sum(
        khue_ecommerce_order_items,
        khue_ecommerce_order_items.quantity * khue_ecommerce_products.price
      )
      | where(khue_ecommerce_orders.status == 'completed')
    )
    -
    (
      sum(
        khue_ecommerce_order_items,
        khue_ecommerce_order_items.quantity * khue_ecommerce_products.cost
      )
      | where(khue_ecommerce_orders.status == 'completed')
    )
  ),
  (
    sum(
      khue_ecommerce_order_items,
      khue_ecommerce_order_items.quantity * khue_ecommerce_products.price
    )
    | where(khue_ecommerce_orders.status == 'completed')
  )
) * 100;;
    format: "none"
  }
  metric customer_count {
    label: "Customer Count "
    type: "number"
    description: ""
    definition: @aql count_distinct(khue_ecommerce_orders.user_id);;
    format: "#,###"
  }
  metric revenue_of_total_by_category {
    label: "Revenue % of Total by Category"
    type: "number"
    hidden: false
    description: ""
    definition: @aql safe_divide(
  total_revenue,
  total_revenue
    | of_all(khue_ecommerce_categories.name)
);;
    format: "#,###%"
  }
  metric month_over_month_revenue_growth {
    label: "Month-over-Month Revenue Growth"
    type: "number"
    description: ""
    definition: @aql safe_divide(
  total_revenue
  -
  (
    total_revenue
    | relative_period(
        khue_date_dim.date,
        interval(-1 month)
      )
  ),
  (
    total_revenue
    | relative_period(
        khue_date_dim.date,
        interval(-1 month)
      )
  )
);;
    format: "#,###%"
  }
}