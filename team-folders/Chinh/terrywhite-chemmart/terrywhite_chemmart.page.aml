Dashboard terrywhite_chemmart {
  title: 'Terrywhite Chemmart'
  description: ''
  owner: 'chinh.dm@holistics.io'

  theme: H.themes.vanilla

  view: CanvasLayout {
    label: 'View 1'
    width: 1300
    height: 800
    grid_size: 20
    auto_expand_vertically: true
    block title {
      position: pos(20, 20, 1260, 60)
    }
    block v_working {
      position: pos(20, 100, 480, 680)
    }
    block f_date {
      position: pos(20, 20, 300, 80)
    }
    block v_0t7d {
      position: pos(500, 100, 780, 680)
    }
    mobile {
      mode: 'auto'
    }
  }

  block v_working: VizBlock {
    label: 'working'
    viz: DataTable {
      dataset: date_filter_shift_test
      fields: [
        VizFieldFull {
          ref: r(dim_date_test_shift_tm.date)
          format {
            type: 'date'
          }
          uname: 'dim_date_test_shift_tm_date_1'
        },
        VizFieldFull {
          ref: r(date_filter_shift_test.fact_sales_total_sales_amount)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(date_filter_shift_test.fact_sales_total_sales_amount_ly)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        show_row_number: true
        sorts: [
          SortSetting {
            key: 'dim_date_test_shift_tm_date_1'
            direction: 'asc'
          }
        ]
        row_limit: 5000
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block f_date: FilterBlock {
    label: 'Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: date_filter_shift_test
      field: r(dim_date_test_shift_tm.date)
    }
    default {
      operator: 'matches'
      value: 'last month'
    }
  }
  block v_0t7d: VizBlock {
    label: 'fiscal_year'
    viz: DataTable {
      dataset: date_filter_shift_test
      fields: [
        VizFieldFull {
          ref: r(dim_date_test_shift_tm.date)
          format {
            type: 'date'
          }
        },
        VizFieldFull {
          ref: r(date_filter_shift_test.fact_sales_total_sales_amount_fytd_v2)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        show_row_number: true
        row_limit: 5000
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  settings {
    timezone: 'Etc/UTC'
    cache_duration: 1440
    autorun_on_open: true
    autorun_on_changes: true
  }
}