Model cfa_model {
  type: 'query'
  label: 'Cfa model'
  description: 'Inline mock CFA data for date range filter POCs.'
  data_source_name: 'data_staging'
  dimension cfa_id {
    label: 'Cfa'
    description: ''
    type: 'text'
    hidden: false
    primary_key: true
    definition: @sql {{ #SOURCE.cfa_id }};;
  }
  dimension customer_name {
    label: 'Customer name'
    description: ''
    type: 'text'
    hidden: false
    definition: @sql {{ #SOURCE.customer_name }};;
  }
  dimension region {
    label: 'Region'
    description: ''
    type: 'text'
    hidden: false
    definition: @sql {{ #SOURCE.region }};;
  }
  dimension cfa_type {
    label: 'Cfa type'
    description: ''
    type: 'text'
    hidden: false
    definition: @sql {{ #SOURCE.cfa_type }};;
  }
  dimension field_a_start_date {
    label: 'Field A (start date)'
    description: ''
    type: 'date'
    hidden: false
    definition: @sql {{ #SOURCE.field_a_start_date }};;
  }
  dimension field_b_end_date {
    label: 'Field B (end date)'
    description: ''
    type: 'date'
    hidden: false
    definition: @sql {{ #SOURCE.field_b_end_date }};;
  }
  dimension cfa_amount {
    label: 'Cfa amount'
    description: ''
    type: 'number'
    hidden: false
    definition: @sql {{ #SOURCE.cfa_amount }};;
  }
  dimension status {
    label: 'Status'
    description: ''
    type: 'text'
    hidden: false
    definition: @sql {{ #SOURCE.status }};;
  }
  dimension expected_for_jan_2026 {
    label: 'Expected for jan 2026'
    description: ''
    type: 'text'
    hidden: false
    definition: @sql {{ #SOURCE.expected_for_jan_2026 }};;
  }

  param cfa_period_param {
    label: 'CFA Period Parameter'
    type: 'date'
  }

  owner: 'chinh.dm@holistics.io'

  query: @sql
    select
      'CFA-001' as cfa_id
      , 'Acme Retail' as customer_name
      , 'North' as region
      , 'Renewal' as cfa_type
      , date '2026-01-01' as field_a_start_date
      , date '2026-01-31' as field_b_end_date
      , 12000 as cfa_amount
      , 'closed' as status
      , 'yes' as expected_for_jan_2026
    union all
    select
      'CFA-002'
      , 'Bright Foods'
      , 'South'
      , 'New'
      , date '2026-01-05'
      , date '2026-01-20'
      , 8500
      , 'closed'
      , 'yes'
    union all
    select
      'CFA-003'
      , 'Core Logistics'
      , 'East'
      , 'Expansion'
      , date '2026-01-15'
      , date '2026-01-31'
      , 6200
      , 'open'
      , 'yes'
    union all
    select
      'CFA-004'
      , 'Delta Health'
      , 'West'
      , 'New'
      , date '2025-12-25'
      , date '2026-01-20'
      , 9100
      , 'closed'
      , 'no_start_before_filter'
    union all
    select
      'CFA-005'
      , 'Evergreen Finance'
      , 'North'
      , 'Renewal'
      , date '2026-01-05'
      , date '2026-02-05'
      , 7400
      , 'open'
      , 'no_end_after_filter'
    union all
    select
      'CFA-006'
      , 'Falcon Manufacturing'
      , 'South'
      , 'Expansion'
      , date '2025-12-20'
      , date '2026-02-10'
      , 13300
      , 'closed'
      , 'no_both_outside'
    union all
    select
      'CFA-007'
      , 'Greenfield Energy'
      , 'East'
      , 'New'
      , date '2026-01-31'
      , date '2026-01-31'
      , 4200
      , 'closed'
      , 'yes'
    union all
    select
      'CFA-008'
      , 'Horizon Media'
      , 'West'
      , 'Renewal'
      , date '2026-01-01'
      , date '2026-01-01'
      , 5600
      , 'open'
      , 'yes'
    union all
    select
      'CFA-009'
      , 'Ironwood Bank'
      , 'North'
      , 'Expansion'
      , date '2025-12-31'
      , date '2026-01-01'
      , 3900
      , 'closed'
      , 'no_start_before_filter'
    union all
    select
      'CFA-010'
      , 'Juniper Travel'
      , 'South'
      , 'New'
      , date '2026-01-31'
      , date '2026-02-01'
      , 4800
      , 'open'
      , 'no_end_after_filter'
    union all
    select
      'CFA-011'
      , 'Keystone Pharma'
      , 'East'
      , 'Renewal'
      , date '2026-02-01'
      , date '2026-02-28'
      , 11200
      , 'closed'
      , 'no_outside_jan'
    union all
    select
      'CFA-012'
      , 'Lumen Software'
      , 'West'
      , 'Expansion'
      , date '2025-12-01'
      , date '2025-12-31'
      , 7700
      , 'closed'
      , 'no_outside_jan'
    union all
    select
      'CFA-013'
      , 'Metro Supply'
      , 'North'
      , 'New'
      , date '2026-03-01'
      , date '2026-03-31'
      , 6900
      , 'open'
      , 'no_outside_jan'
    union all
    select
      'CFA-014'
      , 'Nova Education'
      , 'South'
      , 'Renewal'
      , date '2026-01-10'
      , date '2026-01-10'
      , 2500
      , 'closed'
      , 'yes'
    union all
    select
      'CFA-015'
      , 'Orchid Hospitality'
      , 'East'
      , 'Expansion'
      , date '2026-01-20'
      , date '2026-01-25'
      , 9800
      , 'closed'
      , 'yes'
    union all
    select
      'CFA-016'
      , 'Palmer Utilities'
      , 'North'
      , 'Correction'
      , date '2026-01-10'
      , date '2025-12-28'
      , 3100
      , 'closed'
      , 'yes'
    union all
    select
      'CFA-017'
      , 'Quantum Labs'
      , 'South'
      , 'Backdated'
      , date '2026-02-05'
      , date '2026-01-20'
      , 6600
      , 'open'
      , 'yes'
    union all
    select
      'CFA-018'
      , 'Riverstone Legal'
      , 'East'
      , 'Correction'
      , date '2026-02-10'
      , date '2026-02-01'
      , 7300
      , 'closed'
      , 'no_end_after_filter'
    union all
    select
      'CFA-019'
      , 'Silverline Auto'
      , 'West'
      , 'Backdated'
      , date '2025-12-20'
      , date '2025-12-10'
      , 2900
      , 'open'
      , 'no_start_before_filter'
    union all
    select
      'CFA-020'
      , 'Terrace Telecom'
      , 'North'
      , 'Correction'
      , date '2026-01-31'
      , date '2026-01-15'
      , 5100
      , 'closed'
      , 'yes'
    union all
    select
      'CFA-021'
      , 'Unity Apparel'
      , 'South'
      , 'Backdated'
      , date '2026-03-10'
      , date '2026-01-31'
      , 8800
      , 'open'
      , 'yes'
  ;;

  models: []
}
