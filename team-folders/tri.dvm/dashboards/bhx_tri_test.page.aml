  }
  block v_revenue30d: VizBlock {
    label: 'Total Revenue (Last 30 Days)'
    viz: MetricKpi {
      dataset: bhx_demo_ecommerce
      calculation metric_revenue_last_30d {
        label: 'Total Revenue (Last 30 Days)'
        formula: @aql bhx_ecommerce_order_items | sum(bhx_ecommerce_order_items.quantity * bhx_ecommerce_products.price) | where(bhx_ecommerce_orders.created_at matches @(last 30 days));;
        calc_type: 'measure'
        data_type: 'number'
      }
      value: VizFieldFull {
        ref: 'metric_revenue_last_30d'
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
        alignment: 'left'
      }
    }
  }
