  block v_vr4k: VizBlock {
    label: 'vggg copy'
    viz: DataTable {
      dataset: demo_ecommerce_metrics
      calculation pop_comparison_of_total_order_value {
        label: 'PoP Comparison of Total Order Value'
        formula: @aql safe_divide(total_order_value, total_order_value | relative_period(order_master.order_created_at, -1, strict: true)) - 1;;
        calc_type: 'measure'
        data_type: 'number'
        format {
          type: 'number'
          pattern: '#,###0.00%'
        }
      }
      calculation pop_comparison_of_total_order_value_01 {
        label: 'PoP Comparison of Total Order Value 01'
        formula: @aql safe_divide(total_order_value, total_order_value | relative_period(order_master.order_created_at, -1, strict: true)) - 1;;
        calc_type: 'measure'
        data_type: 'number'
        format {
          type: 'number'
          pattern: '#,###0.00%'
        }
      }
      fields: [
        VizFieldFull {
          ref: r(ecommerce_countries.continent_name)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(ecommerce_cities.country_code)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(demo_ecommerce_metrics.total_order_value)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        wrap_header_text: true
        wrap_cell_text: true
        show_row_number: true
        row_limit: 5000
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block f_cross_raw: FilterBlock {
    label: 'Order Date (raw orders)'
    type: 'field'
    source: FieldFilterSource {
      dataset: bhx_demo_cross_model_date_filter
      field: r(bhx_demo_raw_orders.order_date_param)
    }
    default {
      operator: 'matches'
      value: 'last 90 days'
    }
  }
  block f_cross_first: FilterBlock {
    label: 'Order Date (first order state)'
    type: 'field'
    source: FieldFilterSource {
      dataset: bhx_demo_cross_model_date_filter
      field: r(bhx_demo_first_order_state.order_date_param)
    }
    default {
      operator: 'matches'
      value: 'last 90 days'
    }
  }
  block t_cross_note: TextBlock {
    content: @md **Looker-style pushdown demo**
Set the same date on both filters. Joined viz needs two filters (1 param per widget mapping).;;
  }
  block v_cross_raw: VizBlock {
    label: 'Raw orders (param in SQL)'
    viz: DataTable {
      dataset: bhx_demo_cross_model_date_filter
      fields: [
        VizFieldFull {
