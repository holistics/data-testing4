Dashboard ecommerce_di {
  title: 'ecommerce-di'
  description: ''
  owner: 'di.hoang@holistics.io'
  view: CanvasLayout {
    label: 'View 1'
    width: 1300
    height: 1460
    grid_size: 20
    auto_expand_vertically: true
    mobile {
      mode: 'auto'
    }
    block v_z8hi {
      position: pos(20, 140, 620, 420)
    }
    block v_7jkk {
      position: pos(660, 140, 620, 420)
    }
    block f_order_date {
      position: pos(20, 60, 300, 80)
    }
    block v_0kxb {
      position: pos(20, 580, 620, 420)
    }
    block v_tjma {
      position: pos(660, 580, 620, 420)
    }
    block v_etvq {
      position: pos(20, 1020, 620, 420)
      layer: 1
    }
  }
  theme: H.themes.vanilla
  block v_z8hi: VizBlock {
    label: 'Total Orders by Month Created Date and Status'
    viz: ColumnChart {
      dataset: demo_ecommerce_version_2
      x_axis: VizFieldFull {
        ref: r(ecommerce_orders.created_date)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      legend: VizFieldFull {
        ref: r(ecommerce_orders.status)
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(demo_ecommerce_version_2.total_orders)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        row_limit: 5000
        x_axis_show_null_datetime: false
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_7jkk: VizBlock {
    label: 'Order by Product'
    viz: DataTable {
      dataset: demo_ecommerce_version_2
      fields: [
        VizFieldFull {
          ref: r(ecommerce_orders.created_date)
          format {
            type: 'date'
          }
        },
        VizFieldFull {
          ref: r(ecommerce_users.full_name)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(ecommerce_users.gender)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(ecommerce_countries.name)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(ecommerce_products.name)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(demo_ecommerce_version_2.revenue)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        show_row_number: true
        row_limit: 5000
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block f_order_date: FilterBlock {
    label: 'Order Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: demo_ecommerce_version_2
      field: r(ecommerce_orders.created_date)
    }
    default {
      operator: 'matches'
      value: 'last 3 years'
    }
  }
  block v_0kxb: VizBlock {
    label: 'Year Created Date and Country Name'
    viz: BarChart {
      dataset: demo_ecommerce_version_2
      x_axis: VizFieldFull {
        ref: r(ecommerce_orders.created_date)
        transformation: 'datetrunc year'
        format {
          type: 'date'
          pattern: 'yyyy'
        }
      }
      legend: VizFieldFull {
        ref: r(ecommerce_countries.name)
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            label: ' '
            ref: r(demo_ecommerce_version_2.total_orders)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        row_limit: 5000
        x_axis_show_null_datetime: false
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_tjma: VizBlock {
    label: 'Total Orders by Gender'
    viz: PieChart {
      dataset: demo_ecommerce_version_2
      legend: VizFieldFull {
        ref: r(ecommerce_users.gender)
        format {
          type: 'text'
        }
      }
      series {
        field: VizFieldFull {
          ref: r(demo_ecommerce_version_2.total_orders)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      }
      settings {
        display_as_donut: true
        row_limit: 5000
        data_label_position: 'none'
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_etvq: VizBlock {
    label: 'Actual, Lower Bound and 5 more by Period'
    viz: CombinationChart {
      dataset: demo_ecommerce
      calculation rolling_mean {
        label: 'Rolling Mean'
        formula: @aql window_avg(order_master.gmv, -12..-1, order: dim_dates.date_key | month() | asc(), partition: []);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation rolling_stddev {
        label: 'Rolling Stddev'
        formula: @aql window_stdev(order_master.gmv, -12..-1, order: dim_dates.date_key | month() | asc(), partition: []);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation lower_bound {
        label: 'Lower Bound'
        formula: @aql rolling_mean - 3 * rolling_stddev;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation upper_bound {
        label: 'Upper Bound'
        formula: @aql rolling_mean + 3 * rolling_stddev;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation z_score {
        label: 'Z Score'
        formula: @aql safe_divide(order_master.gmv - rolling_mean, rolling_stddev);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation is_anomaly {
        label: 'Is Anomaly'
        formula: @aql case(when: abs(z_score) > 3, then: 1, else: 0);;
        calc_type: 'measure'
        data_type: 'number'
      }
      x_axis: VizFieldFull {
        label: 'Period'
        ref: r(dim_dates.date_key)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
        uname: 'bucket'
      }
      y_axis {
        label: 'GMV'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Actual'
            ref: r(order_master.gmv)
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
          settings {
            color: '#2563EB'
          }
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Lower Bound'
            ref: 'lower_bound'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
          settings {
            color: '#9CA3AF'
            line_style: 'dashed'
          }
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Upper Bound'
            ref: 'upper_bound'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
          settings {
            color: '#6B7280'
            line_style: 'dashed'
          }
        }
      }
      tooltips: [
        VizTooltip {
          field: VizFieldFull {
            label: 'Actual'
            ref: r(order_master.gmv)
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
        },
        VizTooltip {
          field: VizFieldFull {
            label: 'Rolling Mean'
            ref: 'rolling_mean'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
        },
        VizTooltip {
          field: VizFieldFull {
            label: 'Z Score'
            ref: 'z_score'
            format {
              type: 'number'
              pattern: '#,###0.0'
            }
          }
        },
        VizTooltip {
          field: VizFieldFull {
            label: 'Is Anomaly'
            ref: 'is_anomaly'
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
        }
      ]
      settings {
        connect_discontinuous_points: false
        sort {
          field_index: 0
          direction: 'asc'
          type: 'xaxis'
        }
        x_axis_label: 'Period'
        x_axis_show_null_datetime: true
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
}