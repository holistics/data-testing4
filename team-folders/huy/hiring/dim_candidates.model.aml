Model hiring_dim_candidates {
  type: 'table'
  label: 'Candidates'
  description: 'One row per candidate.'
  data_source_name: 'demodb'
  owner: 'huy.vu@holistics.io'
  table_name: '"hiring"."dim_candidates"'

  dimension candidate_id {
    label: 'Candidate Id'
    type: 'text'
    primary_key: true
    hidden: true
    definition: @sql {{ #SOURCE.candidate_id }};;
  }
  dimension full_name {
    label: 'Full Name'
    type: 'text'
    definition: @sql {{ #SOURCE.full_name }};;
  }
  dimension email {
    label: 'Email'
    type: 'text'
    definition: @sql {{ #SOURCE.email }};;
  }
  dimension location {
    label: 'Location'
    type: 'text'
    definition: @sql {{ #SOURCE.location }};;
  }
  dimension gender {
    label: 'Gender'
    type: 'text'
    definition: @sql {{ #SOURCE.gender }};;
  }
  dimension ethnicity {
    label: 'Ethnicity'
    type: 'text'
    definition: @sql {{ #SOURCE.ethnicity }};;
  }

  measure total_candidates {
    label: 'Total Candidates'
    type: 'number'
    definition: @sql {{ candidate_id }};;
    aggregation_type: 'count'
  }
}
