  block v_91yu: VizBlock {
    label: 'This month Revenue copy'
    viz: MetricKpi {
      dataset: vyhuynh_ecommerce_dataset
      calculation monthly_revenue {
        label: 'Monthly Revenue'
        formula: @aql vyht_ecommerce_order_items
  | sum(vyht_ecommerce_order_items.quantity * vyht_ecommerce_products.price);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation max_of_orders_status {
        label: 'Max of Orders Status'
        formula: @aql max(vyht_ecommerce_orders_1.status);;
        calc_type: 'measure'
        data_type: 'text'
      }
      calculation max_of_orders_status_01 {
        label: 'Max of Orders Status 01'
        formula: @aql max(vyht_ecommerce_orders_1.status);;
        calc_type: 'measure'
        data_type: 'text'
      }
      value: VizFieldFull {
        ref: r(publift_test_data_csv.earning)
        aggregation: 'sum'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
        alignment: 'left'
      }
    }
    settings {
      hide_label: true
    }
  }
  block v_nir7: VizBlock {
    label: 'Currency Symbol'
    viz: MetricKpi {
      dataset: vyhuynh_ecommerce_dataset
      calculation monthly_revenue {
        label: 'Monthly Revenue'
        formula: @aql vyht_ecommerce_order_items
  | sum(vyht_ecommerce_order_items.quantity * vyht_ecommerce_products.price);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation max_of_orders_status {
        label: 'Max of Orders Status'
        formula: @aql max(vyht_ecommerce_orders_1.status);;
        calc_type: 'measure'
        data_type: 'text'
      }
      calculation max_of_orders_status_01 {
        label: 'Max of Orders Status 01'
        formula: @aql max(vyht_ecommerce_orders_1.status);;
        calc_type: 'measure'
        data_type: 'text'
      }
      value: VizFieldFull {
        label: ' Currency Symbol'
        ref: r(vyhuynh_ecommerce_dataset.currency_symbol)
        format {
          type: 'text'
        }
      }
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
        alignment: 'left'
      }
    }
    settings {
      hide_label: true
    }
  }
  block f_publift_test_data_csv_currency: FilterBlock {
    label: 'Currency'
    type: 'field'
    source: FieldFilterSource {
      dataset: vyhuynh_ecommerce_dataset
      field: r(publift_test_data_csv.currency)
    }
    default {
      operator: 'is'
      value: 'USD'
    }
    settings {
      input_type: 'single'
    }
  }
  block v_15s1: VizBlock {
    label: 'Sum of Earning'
    viz: MarkdownViz {
      dataset: vyhuynh_ecommerce_dataset
      values: [
        VizFieldFull {
          ref: r(publift_test_data_csv.earning)
          aggregation: 'sum'
          format {
            type: 'number'
            pattern: '#,###'
          }
        },
        VizFieldFull {
          ref: r(vyhuynh_ecommerce_dataset.currency_symbol)
          format {
            type: 'text'
          }
        }
      ]
      content: @md <style>

  .kpi-title {
    margin: 0;
    color: #8e94a5;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .kpi-value {
    font-size: 52px;
    font-weight: 500;
    color: #5DB88F;
    line-height: 1;
  }

  
</style>

<div>
  <p class="kpi-title">Sum of Earning</p>
  <div class="kpi-value">
    {{ rows[0].values.`Sum of Earning` }}
    {{ rows[0].values.`Currency Symbol` }}
  </div>

</div>                ;;
      settings {
        show_row_total: true
        show_column_total: true
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
    settings {
      hide_label: true
    }
  }
