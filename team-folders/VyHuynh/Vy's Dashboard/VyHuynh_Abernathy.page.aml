          field_index: 2
          direction: 'asc'
          type: 'series'
        }
        legend_label: 'top'
        x_axis_label: 'Owner'
      }
    }
  }
  block v_0725: VizBlock {
    label: '''Anomaly detection: Revenue Won (Oct 2019-Nov 2021)
'''
    viz: CombinationChart {
      dataset: vy_pbi_dts
      calculation rolling_mean {
        label: 'Rolling Mean'
        formula: @aql window_avg(revenue_won, -12..-1, order: vy_opportunity_calendar_csv.year_month | asc(), partition: []);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation rolling_stddev {
        label: 'Rolling Stddev'
        formula: @aql window_stdev(revenue_won, -12..-1, order: vy_opportunity_calendar_csv.year_month | asc(), partition: []);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation lower_bound {
        label: 'Lower Bound'
        formula: @aql rolling_mean - 3 * rolling_stddev;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation upper_bound {
        label: 'Upper Bound'
        formula: @aql rolling_mean + 3 * rolling_stddev;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation z_score {
        label: 'Z Score'
        formula: @aql safe_divide(revenue_won - rolling_mean, rolling_stddev);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation is_anomaly {
        label: 'Is Anomaly'
        formula: @aql case(when: abs(z_score) > 3, then: 1, else: 0);;
        calc_type: 'measure'
        data_type: 'number'
      }
      x_axis: VizFieldFull {
        label: 'Period'
        ref: r(vy_opportunity_calendar_csv.year_month)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
        uname: 'bucket'
      }
      y_axis {
        label: 'Revenue Won'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Actual'
            ref: r(vy_pbi_dts.revenue_won)
            format {
              type: 'number'
              pattern: '[$]#,###0'
            }
          }
          settings {
            color: '#2563EB'
          }
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Lower Bound'
            ref: 'lower_bound'
            format {
              type: 'number'
              pattern: '[$]#,###0'
            }
          }
          settings {
            color: '#9CA3AF'
            line_style: 'dashed'
          }
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Upper Bound'
            ref: 'upper_bound'
            format {
              type: 'number'
              pattern: '[$]#,###0'
            }
          }
          settings {
            color: '#6B7280'
            line_style: 'dashed'
          }
        }
      }
      y_axis {
        label: 'Anomaly'
        settings {
          alignment: 'right'
          axis_min: 0
          axis_max: 1
        }
        series {
          mark_type: 'column'
          field: VizFieldFull {
            label: 'Is Anomaly'
            ref: 'is_anomaly'
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
          settings {
            color: '#FCA5A5'
          }
        }
      }
      tooltips: [
        VizTooltip {
          field: VizFieldFull {
            label: 'Actual'
            ref: r(vy_pbi_dts.revenue_won)
            format {
              type: 'number'
              pattern: '[$]#,###0'
            }
          }
        },
        VizTooltip {
          field: VizFieldFull {
            label: 'Rolling Mean'
            ref: 'rolling_mean'
            format {
              type: 'number'
              pattern: '[$]#,###0'
            }
          }
        },
        VizTooltip {
          field: VizFieldFull {
            label: 'Z Score'
            ref: 'z_score'
            format {
              type: 'number'
              pattern: '#,###0.0'
            }
          }
        },
        VizTooltip {
          field: VizFieldFull {
            label: 'Is Anomaly'
            ref: 'is_anomaly'
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
        }
      ]
      settings {
        connect_discontinuous_points: false
        row_limit: 5000
        sort {
          field_index: 0
          direction: 'asc'
          type: 'xaxis'
        }
        x_axis_label: 'Period'
      }
    }
  }
