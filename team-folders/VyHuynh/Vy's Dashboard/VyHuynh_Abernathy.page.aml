          format {
            type: 'number'
            pattern: '#,###0.00'
          }
        },
        VizFieldFull {
          label: 'Comparison Value'
          ref: 'comparison_value'
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
        },
        VizFieldFull {
          label: 'Member Change'
          ref: 'member_change'
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
          uname: 'custom_member_change_1'
        },
        VizFieldFull {
          label: 'Is Offsetting Member'
          ref: 'is_offsetting_member'
        }
      ]
      settings {
        pagination_size: 100
