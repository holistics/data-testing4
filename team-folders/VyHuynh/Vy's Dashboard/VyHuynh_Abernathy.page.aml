  block v_9oui: VizBlock {
    label: 'Number of bug change by status for May 2025 vs April 2025'
    viz: PivotTable {
      dataset: reporting_project_management
      calculation number_of_bug_may_2025 {
        label: 'Number Of Bug May 2025'
        formula: @aql number_of_bug | where(reporting_issues.completed_at is @(2025-05));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation number_of_bug_apr_2025 {
        label: 'Number Of Bug Apr 2025'
        formula: @aql number_of_bug | where(reporting_issues.completed_at is @(2025-04));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation member_change {
        label: 'Member Change'
        formula: @aql number_of_bug_may_2025 - number_of_bug_apr_2025;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation is_offsetting_member {
        label: 'Is Offsetting Member'
        formula: @aql member_change <= 0;;
        calc_type: 'measure'
        data_type: 'truefalse'
      }
      filter {
        field: r(reporting_project.name)
        operator: 'is'
        value: 'Explore 2'
      }
      theme {
      }
      rows: [
        VizFieldFull {
          label: 'Status'
          ref: r(reporting_issues.status)
          format {
            type: 'text'
          }
          uname: 'reporting_issues_status'
        }
      ]
      values: [
        VizFieldFull {
          label: 'Base Value'
          ref: 'number_of_bug_may_2025'
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
        },
        VizFieldFull {
          label: 'Comparison Value'
          ref: 'number_of_bug_apr_2025'
