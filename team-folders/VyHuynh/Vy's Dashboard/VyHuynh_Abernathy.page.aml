  block v_02lk: VizBlock {
    label: 'Bug count change by priority for May 2025 vs April 2025'
    viz: PivotTable {
      dataset: reporting_project_management
      calculation base_value_metric {
        label: 'Base Value Metric'
        formula: @aql number_of_bug | where(reporting_issues.completed_at is @(2025-05));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation comparison_value_metric {
        label: 'Comparison Value Metric'
        formula: @aql number_of_bug | where(reporting_issues.completed_at is @(2025-04));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation member_change_metric {
        label: 'Member Change Metric'
        formula: @aql base_value_metric - comparison_value_metric;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation is_offsetting_member_metric {
        label: 'Is Offsetting Member Metric'
        formula: @aql case(when: member_change_metric < 1, then: 1, else: 0);;
        calc_type: 'measure'
        data_type: 'number'
      }
      filter {
        field: r(reporting_project.name)
        operator: 'is'
        value: 'Explore 2'
      }
      filter {
        field: r(reporting_issues.completed_at)
        operator: 'matches'
        value: '2025-04 - 2025-05'
      }
      theme {
      }
      rows: [
        VizFieldFull {
          label: 'Priority'
          ref: r(reporting_issues.priority)
          format {
            type: 'text'
          }
        }
      ]
      values: [
        VizFieldFull {
          label: 'Base Value'
          ref: 'base_value_metric'
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
        },
        VizFieldFull {
          label: 'Comparison Value'
          ref: 'comparison_value_metric'
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
        },
        VizFieldFull {
          label: 'Member Change'
          ref: 'member_change_metric'
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
          uname: 'custom_member_change_metric_1'
        },
        VizFieldFull {
          label: 'Is Offsetting Member'
          ref: 'is_offsetting_member_metric'
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
        }
      ]
      settings {
        pagination_size: 100
        show_row_total: true
        show_column_total: true
        show_sub_total: true
        sorts: [
          SortSetting {
            key: 'custom_member_change_metric_1'
            direction: 'desc'
