  block v_fb2g: VizBlock {
    label: 'Campaign, Revenue Won and 2 more'
    viz: DataTable {
      dataset: vy_pbi_dts
      calculation revenue_won_mar_2021 {
        label: 'Revenue Won Mar 2021'
        formula: @aql revenue_won | where(vy_opportunity_calendar_csv.year_month is @(2021-03));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation revenue_won_apr_2021 {
        label: 'Revenue Won Apr 2021'
        formula: @aql revenue_won | where(vy_opportunity_calendar_csv.year_month is @(2021-04));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation base_value {
        label: 'Base Value'
        formula: @aql coalesce(revenue_won_mar_2021, 0);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation comparison_value {
        label: 'Comparison Value'
        formula: @aql coalesce(revenue_won_apr_2021, 0);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation delta_value {
        label: 'Delta Value'
        formula: @aql comparison_value - base_value;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation campaigns_in_either_month {
        label: 'Campaigns In Either Month'
        formula: @aql unique(vy_campaigns_csv.campaign)
  | filter(revenue_won_mar_2021 is not null or revenue_won_apr_2021 is not null);;
        calc_type: 'measure'
        data_type: 'json'
      }
      calculation lm_revenue_won {
        label: 'LM Revenue Won'
        formula: @aql revenue_won | relative_period(vy_opportunities_csv.close_date, interval(-1 month), strict: true);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation _lm_revenue_won {
        label: '% LM Revenue Won'
        formula: @aql safe_divide(revenue_won, revenue_won | relative_period(vy_opportunities_csv.close_date, interval(-1 month), strict: true)) - 1;;
        calc_type: 'measure'
        data_type: 'number'
        format {
          type: 'number'
          pattern: '#,###0.00%'
        }
      }
      filter {
        field: r(vy_opportunities_csv.close_date)
        operator: 'matches'
        value: 'april 2021'
      }
      fields: [
        VizFieldFull {
          label: 'Campaign'
          ref: r(vy_campaigns_csv.campaign)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(vy_pbi_dts.revenue_won)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'lm_revenue_won'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: '_lm_revenue_won'
          format {
            type: 'number'
            pattern: '#,###0.00%'
          }
          uname: 'custom__lm_revenue_won_1'
        }
      ]
      settings {
        pagination_size: 100
        show_row_number: true
        sorts: [
          SortSetting {
            key: 'custom__lm_revenue_won_1'
            direction: 'desc'
          }
        ]
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_wxn2: VizBlock {
    label: 'Jan 2021, Dec 2020 and 2 more by Product Category'
    viz: ColumnChart {
      dataset: vy_pbi_dts
      calculation base_won_count {
        label: 'Base Won Count'
        formula: @aql coalesce(vy_opportunities_csv | count(vy_opportunities_csv.opportunity_seq) | where(vy_opportunities_csv.status == 'Won') | where(vy_opportunity_calendar_csv.year_month is @(2021-01)), 0);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation base_lost_count {
        label: 'Base Lost Count'
        formula: @aql coalesce(vy_opportunities_csv | count(vy_opportunities_csv.opportunity_seq) | where(vy_opportunities_csv.status == 'Lost') | where(vy_opportunity_calendar_csv.year_month is @(2021-01)), 0);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation comparison_won_count {
        label: 'Comparison Won Count'
        formula: @aql coalesce(vy_opportunities_csv | count(vy_opportunities_csv.opportunity_seq) | where(vy_opportunities_csv.status == 'Won') | where(vy_opportunity_calendar_csv.year_month is @(2020-12)), 0);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation comparison_lost_count {
        label: 'Comparison Lost Count'
        formula: @aql coalesce(vy_opportunities_csv | count(vy_opportunities_csv.opportunity_seq) | where(vy_opportunities_csv.status == 'Lost') | where(vy_opportunity_calendar_csv.year_month is @(2020-12)), 0);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation base_value_raw {
        label: 'Base Value Raw'
        formula: @aql safe_divide(base_won_count, base_won_count + base_lost_count);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation comparison_value_raw {
        label: 'Comparison Value Raw'
        formula: @aql safe_divide(comparison_won_count, comparison_won_count + comparison_lost_count);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation base_value {
        label: 'Base Value'
        formula: @aql coalesce(base_value_raw, 0);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation comparison_value {
        label: 'Comparison Value'
        formula: @aql coalesce(comparison_value_raw, 0);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation delta_value {
        label: 'Delta Value'
        formula: @aql base_value - comparison_value;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation pct_delta {
        label: 'Pct Delta'
        formula: @aql safe_divide(delta_value, comparison_value) * 100.0;;
        calc_type: 'measure'
        data_type: 'number'
      }
      filter {
        field: r(vy_opportunity_calendar_csv.year_month)
        operator: 'matches'
        value: '2020-12 - 2021-01'
      }
      x_axis: VizFieldFull {
        label: 'Product Category'
        ref: r(vy_products_csv.product_category)
        format {
          type: 'text'
        }
      }
      y_axis {
        label: 'Close %'
        series {
          field: VizFieldFull {
            label: 'Jan 2021'
            ref: 'base_value'
            format {
              type: 'number'
              pattern: '#,###0.0%'
            }
          }
          settings {
            color: '#0891F2'
          }
        }
        series {
          field: VizFieldFull {
            label: 'Dec 2020'
            ref: 'comparison_value'
            format {
              type: 'number'
              pattern: '#,###0.0%'
            }
          }
          settings {
            color: '#F1434B'
          }
        }
      }
      tooltips: [
        VizTooltip {
          field: VizFieldFull {
            label: 'Δ'
            ref: 'delta_value'
            format {
              type: 'number'
              pattern: '#,###0.0%'
            }
          }
        },
        VizTooltip {
          field: VizFieldFull {
            label: '% Change'
            ref: 'pct_delta'
            format {
              type: 'number'
              pattern: '#,###0.0\\%'
            }
          }
        }
      ]
      settings {
        show_rows_with_no_data: true
        row_limit: 5000
        sort {
          field_index: 0
          direction: 'asc'
          type: 'tooltip'
        }
        x_axis_label: 'Product Category'
        x_axis_show_null_datetime: true
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_m2xo: VizBlock {
    label: '''Revenue Won Change by Owner: February 2021 vs January 2021
'''
    viz: CombinationChart {
      dataset: vy_pbi_dts
      calculation base_value_raw {
        label: 'Base Value Raw'
        formula: @aql revenue_won | where(vy_opportunity_calendar_csv.year_month is @(February 2021));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation comparison_value_raw {
        label: 'Comparison Value Raw'
        formula: @aql revenue_won | where(vy_opportunity_calendar_csv.year_month is @(January 2021));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation base_value {
        label: 'February 2021'
        formula: @aql coalesce(base_value_raw, 0);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation comparison_value {
        label: 'January 2021'
        formula: @aql coalesce(comparison_value_raw, 0);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation delta_value {
        label: 'Δ Change'
        formula: @aql base_value - comparison_value;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation pct_delta {
        label: 'Pct Delta'
        formula: @aql safe_divide(delta_value, comparison_value_raw) * 100.0;;
        calc_type: 'measure'
        data_type: 'number'
      }
      conditions: [
        'vy_opportunity_calendar_csv.year_month is @(January 2021 - February 2021)'
      ]
      x_axis: VizFieldFull {
        label: 'Owner'
        ref: r(vy_owners_csv.owner)
