          debug_comments: true
        }
      }
    }
  }
  block v_ztqi: VizBlock {
    label: 'Table 1'
    viz: PivotTable {
      dataset: demo_ecommerce
      rows: [
        VizFieldFull {
          ref: r(order_master.order_created_at)
          transformation: 'datetrunc year'
          format {
            type: 'date'
            pattern: 'yyyy'
          }
        },
        VizFieldFull {
          ref: r(order_master.order_created_at)
          transformation: 'datetrunc month'
          format {
            type: 'date'
            pattern: 'LLL yyyy'
          }
        }
      ]
      values: [
        VizFieldFull {
          ref: r(order_master.user_id)
          aggregation: 'count distinct'
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'count_distinct_user_id_1'
        }
