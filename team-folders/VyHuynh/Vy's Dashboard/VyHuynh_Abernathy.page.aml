  block v_nd9q: VizBlock {
    label: '''Close % by Owner — Delta on Second Y-Axis
'''
    viz: CombinationChart {
      dataset: vy_pbi_dts
      calculation won_opportunity_count {
        label: 'Won Opportunity Count'
        formula: @aql vy_opportunities_csv | count(vy_opportunities_csv.opportunity_seq) | where(vy_opportunities_csv.status == 'Won');;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation lost_opportunity_count {
        label: 'Lost Opportunity Count'
        formula: @aql vy_opportunities_csv | count(vy_opportunities_csv.opportunity_seq) | where(vy_opportunities_csv.status == 'Lost');;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation q4_2020_won_count {
        label: 'Q4 2020 Won Count'
        formula: @aql won_opportunity_count | where(vy_opportunity_calendar_csv.year_month is @(2020-10 until 2021-01));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation q4_2020_lost_count {
        label: 'Q4 2020 Lost Count'
        formula: @aql lost_opportunity_count | where(vy_opportunity_calendar_csv.year_month is @(2020-10 until 2021-01));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation q1_2021_won_count {
        label: 'Q1 2021 Won Count'
        formula: @aql won_opportunity_count | where(vy_opportunity_calendar_csv.year_month is @(2021-01 until 2021-04));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation q1_2021_lost_count {
        label: 'Q1 2021 Lost Count'
        formula: @aql lost_opportunity_count | where(vy_opportunity_calendar_csv.year_month is @(2021-01 until 2021-04));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation comparison_value_q4_2020 {
        label: 'Q4 2020 Close %'
        formula: @aql safe_divide(coalesce(q4_2020_won_count, 0), coalesce(q4_2020_won_count, 0) + coalesce(q4_2020_lost_count, 0));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation base_value_q1_2021 {
        label: 'Q1 2021 Close %'
        formula: @aql safe_divide(coalesce(q1_2021_won_count, 0), coalesce(q1_2021_won_count, 0) + coalesce(q1_2021_lost_count, 0));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation delta_value {
        label: 'Δ Change'
        formula: @aql base_value_q1_2021 - comparison_value_q4_2020;;
        calc_type: 'measure'
        data_type: 'number'
      }
      x_axis: VizFieldFull {
        label: 'Owner'
        ref: r(vy_owners_csv.owner)
        format {
          type: 'text'
        }
      }
      y_axis {
        label: 'Close %'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            label: 'Q1 2021 Close %'
            ref: 'base_value_q1_2021'
            format {
              type: 'number'
              pattern: '#,###0.0%'
            }
          }
        }
        series {
          mark_type: 'column'
          field: VizFieldFull {
            label: 'Q4 2020 Close %'
            ref: 'comparison_value_q4_2020'
            format {
              type: 'number'
              pattern: '#,###0.0%'
            }
          }
        }
      }
      y_axis {
        label: 'Δ Change'
        settings {
          alignment: 'right'
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Δ Change'
            ref: 'delta_value'
            format {
              type: 'number'
              pattern: '#,###0.0%'
            }
          }
        }
      }
      tooltips: [
        VizTooltip {
          field: VizFieldFull {
            label: 'Q1 2021 Close %'
            ref: 'base_value_q1_2021'
            format {
              type: 'number'
              pattern: '#,###0.0%'
            }
          }
        },
        VizTooltip {
          field: VizFieldFull {
            label: 'Q4 2020 Close %'
            ref: 'comparison_value_q4_2020'
            format {
              type: 'number'
              pattern: '#,###0.0%'
            }
          }
        },
        VizTooltip {
          field: VizFieldFull {
            label: 'Δ Change'
            ref: 'delta_value'
            format {
              type: 'number'
              pattern: '#,###0.0%'
            }
          }
        }
      ]
      settings {
        show_data_points: true
        sort {
          field_index: 1
          direction: 'asc'
          type: 'yaxis'
        }
        legend_label: 'top'
        x_axis_label: 'Owner'
      }
    }
  }
  block v_oa26: VizBlock {
    label: 'GMV over time copy'
    description: 'This is description of the block'
    viz: ColumnChart {
      dataset: demo_ecommerce
      calculation adhoc_dim {
        label: 'My adhoc dim'
        formula: @aql concat(cast(total_orders, 'text'), " ", ecommerce_countries.continent_name);;
        calc_type: 'dimension'
        data_type: 'text'
        model: order_master
      }
      x_axis: VizFieldFull {
        ref: r(order_master.order_created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        settings {
          show_data_label_by: 'value'
        }
        series {
          field: VizFieldFull {
            ref: r(order_master.gmv)
            format {
              type: 'number'
              pattern: '#,###'
            }
          }
        }
      }
      settings {
        row_limit: 5000
        x_axis_show_null_datetime: false
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
