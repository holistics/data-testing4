Dashboard khai_personal_xnpsd {
  title: 'khai_personal'
  owner: 'khai.to@holistics.io'
  block title: TextBlock {
    content: @md # Your title goes here ;;
  }
  block v_f0xo: VizBlock {
    label: 'Name, Is Country and 3 more'
    viz: DataTable {
      dataset: khai_ecommerce
      theme {

      }
      fields: [
        VizFieldFull {
          ref: r(countries.name)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(khai_ecommerce.gmv)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(khai_ecommerce.gmv_converted)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(khai_ecommerce.revenue_per_active_customers)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        show_row_number: true
        row_limit: 5000
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  interactions: []
  view: CanvasLayout {
    label: 'View 1'
    width: 1300
    height: 830
    grid_size: 20
    auto_expand_vertically: true
    block title {
      position: pos(20, 20, 1260, 60)
    }
    block v_f0xo {
      position: pos(80, 160, 620, 420)
    }
    mobile {
      mode: 'auto'
    }
  }
  theme: H.themes.vanilla
}