        font_family: blue_neutral_brand("font_body")
        font_size: 13
        border_color: blue_neutral_brand("border_dark")
        grid_color: blue_neutral_brand("border_dark")
        border_width: 1
        hover_color: "oklch(0.29 0.035 258)"
        banding_color: "oklch(0.27 0.035 258)"
      }
      header { bg_color: blue_neutral_brand("background_dark") font_color: blue_neutral_brand("text_primary_dark") font_size: 13 font_weight: "semibold" }
      sub_header { bg_color: "oklch(0.27 0.035 258)" font_color: blue_neutral_brand("text_muted_dark") font_size: 13 font_weight: "medium" }
      sub_title { font_color: blue_neutral_brand("text_subtle_dark") font_size: 12 font_weight: "medium" }
