        negative { text { font_color: blue_neutral_brand("semantic_danger_dark") font_weight: "medium" } background { bg_color: "oklch(0.40 0.04 25)" } }
        neutral { text { font_color: blue_neutral_brand("text_muted_dark") font_weight: "normal" } background { bg_color: "oklch(0.32 0.03 258)" } }
