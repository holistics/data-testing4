Dashboard vux_dashboard_test {
  title: 'vux-dashboard-test'
  description: ''
  owner: 'vu.dq@holistics.io'
  block title: TextBlock {
    content: @md # Your title goes here ;;
  }
  block t_0s3t: TextBlock {
    content: @md # Your title goes here ;;
  }
  block t_9hnc: TextBlock {
    content: @md # Your title goes here ;;
  }

  view: CanvasLayout {
    label: 'View 1'
    width: 1300
    height: 800
    grid_size: 20
    auto_expand_vertically: true
    block title {
      position: pos(20, 20, 1260, 60)
    }
    block t_0s3t {
      position: pos(70, 70, 1260, 60)
    }
    block t_9hnc {
      position: pos(120, 120, 1260, 60)
    }
    mobile {
      mode: 'auto'
    }
  }

  theme: H.themes.vanilla
}