// BigQuery `keboola.order_properties_mapping` — one row per `order_properties_hashed`.
// Join from `fact_orders.order_properties_hashed` (PBI entity `order_properties_mapping`).
Model dim_order_properties {
  type: 'query'
  label: 'Order properties'
  data_source_name: 'data_staging'
  query: @sql
SELECT
  order_properties_hashed,
  was_price_quote,
  vat_payer,
  user_registered,
  refund_status,
  payment_status,
  order_type,
  status,
  reclamation_status,
  pq_status
FROM `keboola.order_properties_mapping`
;;
  dimension order_properties_hashed {
    label: 'Order Properties Hash'
    type: 'text'
    primary_key: true
    hidden: true
  }

  dimension was_price_quote {
    label: 'Was price quote'
    type: 'text'
  }

  dimension vat_payer {
    label: 'VAT payer'
    type: 'text'
  }

  dimension user_registered {
    label: 'User registered'
    type: 'text'
  }

  dimension refund_status {
    label: 'Refund status'
    type: 'text'
  }

  dimension payment_status {
    label: 'Payment status'
    type: 'text'
  }

  dimension order_type {
    label: 'Order type'
    type: 'text'
  }

  dimension status {
    label: 'Order status'
    type: 'text'
  }

  dimension reclamation_status {
    label: 'Reclamation status'
    type: 'text'
  }

  dimension pq_status {
    label: 'PQ status'
    type: 'text'
  }
}
