// Calendar from BigQuery `keboola.Dates` with data-quality filter: drop rows where
// `YEAR` is null (matches PBI `Dates.YEAR NOT IN (null)` report filter).
Model dim_dates_prusa {
  type: 'query'
  label: 'Dates'
  data_source_name: 'data_staging'
  query: @sql
SELECT *
FROM `keboola.Dates`
WHERE `YEAR` IS NOT NULL
;;

  // Only the calendar PK is exposed. All other granularity (year, month,
  // quarter, week-of-year, day-of-week, indexes) is derived natively in
  // Holistics via date_trunc / date_part / period helpers — no need to
  // mirror PBI's `day index` / `month index` / `YEAR` columns.
  // NB: the warehouse column is `DATE`, but `date` is treated as a reserved
  // identifier by AQL (compiles to invalid SQL when used as a filter, and is
  // rejected as a dimension reference). Expose it as `full_date` instead.
  // Holistics auto-quotes column names for BigQuery, so we do **not** wrap
  // `DATE` in backticks inside `#SOURCE.` — doing so produced an empty
  // SQL identifier ("Invalid empty identifier at [5:28]").
  dimension full_date {
    label: 'Date'
    type: 'date'
    primary_key: true
    definition: @sql {{ #SOURCE.DATE }};;
  }
}
