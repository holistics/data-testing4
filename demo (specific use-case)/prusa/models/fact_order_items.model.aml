// Source of truth: BigQuery `keboola.order_items` (verified via Holistics MCP
// `read_data_source_table_schema`). PBI Power Query had renamed `item_name` →
// `Product name` and `quantity` → `Quantity (pieces)`; those renames live only
// in the PBI semantic model. Use the raw BQ names below.
Model fact_order_items {
  type: 'table'
  label: 'Order Items'
  data_source_name: 'data_staging'
  table_name: 'keboola.order_items'

  dimension order_id {
    label: 'Order ID'
    type: 'text'
  }

  dimension product_id {
    label: 'Product ID'
    type: 'text'
  }

  dimension item_name {
    label: 'Product Name'
    type: 'text'
  }

  dimension quantity {
    label: 'Quantity'
    type: 'number'
    description: 'Stored as STRING in BigQuery; cast for aggregation.'
    definition: @sql SAFE_CAST({{#SOURCE.quantity}} AS FLOAT64);;
  }

  dimension total_price_without_vat_czk {
    label: 'Total Price (excl. VAT, CZK)'
    type: 'number'
  }

  dimension total_price_with_vat_czk {
    label: 'Total Price (incl. VAT, CZK)'
    type: 'number'
  }

  dimension order_items_properties_hashed {
    label: 'Order Item Properties Hash'
    type: 'text'
    hidden: true
  }

  dimension total_margin {
    label: 'Total Margin'
    type: 'number'
  }
}
