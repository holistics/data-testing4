// Same grain as `fact_order_items` but restricted to Overview-style orders plus
// line-level item_type filter (exclude Payment, Transport, undefined).
Model fact_order_items_clean {
  type: 'query'
  label: 'Order items (Overview subset)'
  data_source_name: 'data_staging'
  query: @sql
SELECT oi.*
FROM `keboola.order_items` oi
INNER JOIN `keboola.orders` o
  ON oi.order_id = o.id
INNER JOIN `keboola.order_properties_mapping` op
  ON o.order_properties_hashed = op.order_properties_hashed
LEFT JOIN `keboola.customers` c
  ON o.customer_user_id = c.id
LEFT JOIN `keboola.customer_properties_mapping` cp
  ON c.customer_properties_hashed = cp.customer_properties_hashed
INNER JOIN `keboola.order_items_properties_mapping` oip
  ON oi.order_items_properties_hashed = oip.order_items_properties_hashed
WHERE op.payment_status = 'paid'
  AND op.status NOT IN ('Canceled', 'Canceled but replaced')
  AND op.refund_status != 'Refunded'
  AND (cp.pricing_group IS NULL OR cp.pricing_group NOT IN ('Amazon', 'Printed Solid'))
  AND IFNULL(TRIM(oip.item_type), '') NOT IN ('Payment', 'Transport', 'undefined')
;;

  dimension order_id {
    label: 'Order ID'
    type: 'text'
  }

  dimension product_id {
    label: 'Product ID'
    type: 'text'
  }

  dimension item_name {
    label: 'Product Name'
    type: 'text'
  }

  dimension quantity {
    label: 'Quantity'
    type: 'number'
    description: 'Stored as STRING in BigQuery; cast for aggregation.'
    definition: @sql SAFE_CAST({{#SOURCE.quantity}} AS FLOAT64);;
  }

  dimension total_price_without_vat_czk {
    label: 'Total Price (excl. VAT, CZK)'
    type: 'number'
  }

  dimension total_price_with_vat_czk {
    label: 'Total Price (incl. VAT, CZK)'
    type: 'number'
  }

  dimension order_items_properties_hashed {
    label: 'Order Item Properties Hash'
    type: 'text'
    hidden: true
  }

  dimension total_margin {
    label: 'Total Margin'
    type: 'number'
  }
}
