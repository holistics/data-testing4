// Source of truth: BigQuery `keboola.customers` (verified via Holistics MCP).
// All fields except `id`, `email`, `customer_properties_hashed` are STRING in
// BigQuery; cast in metrics if numeric aggregation is needed.
Model dim_customers {
  type: 'table'
  label: 'Customers'
  data_source_name: 'data_staging'
  table_name: 'keboola.customers'

  dimension id {
    label: 'Customer ID'
    type: 'text'
    primary_key: true
  }

  dimension email {
    label: 'Email'
    type: 'text'
  }

  dimension vip {
    label: 'VIP'
    type: 'text'
  }

  dimension number_of_orders {
    label: 'Number of Orders (snapshot)'
    type: 'text'
  }

  dimension printers_bought {
    label: 'Printers Bought'
    type: 'text'
  }

  dimension first_mkt_product_category {
    label: 'First Marketing Product Category'
    type: 'text'
  }

  dimension printables_id {
    label: 'Printables User ID'
    type: 'text'
  }

  dimension customer_properties_hashed {
    label: 'Customer Properties Hash'
    type: 'text'
    hidden: true
  }
}
