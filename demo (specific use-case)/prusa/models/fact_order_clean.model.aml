// Same grain as `fact_orders` but restricted to the Performance Overview
// "Overview" page semantic defaults: paid, successful, non-refunded, non-reseller
// pricing groups (see `pbi-export/visuals/page_filter_audit.md`).
Model fact_orders_clean {
  type: 'query'
  label: 'Orders (Overview subset)'
  data_source_name: 'data_staging'
  query: @sql
SELECT o.*
FROM `keboola.orders` o
INNER JOIN `keboola.order_properties_mapping` op
  ON o.order_properties_hashed = op.order_properties_hashed
LEFT JOIN `keboola.customers` c
  ON o.customer_user_id = c.id
LEFT JOIN `keboola.customer_properties_mapping` cp
  ON c.customer_properties_hashed = cp.customer_properties_hashed
WHERE op.payment_status = 'paid'
  AND op.status NOT IN ('Canceled', 'Canceled but replaced')
  AND op.refund_status != 'Refunded'
  AND (cp.pricing_group IS NULL OR cp.pricing_group NOT IN ('Amazon', 'Printed Solid'))
;;

  dimension id {
    label: 'Order ID'
    type: 'text'
    primary_key: true
  }

  dimension customer_user_id {
    label: 'Customer User ID'
    type: 'text'
  }

  dimension transport {
    label: 'Transport'
    type: 'text'
  }

  dimension payment {
    label: 'Payment'
    type: 'text'
  }

  dimension currency {
    label: 'Currency'
    type: 'text'
  }

  dimension number {
    label: 'Order Number'
    type: 'text'
  }

  dimension created_at {
    label: 'Created At (raw)'
    type: 'text'
    description: 'Raw STRING column from BigQuery. Use `created_at_date` for joins/filters.'
    hidden: true
  }

  dimension created_at_date {
    label: 'Order Date'
    type: 'date'
    description: 'Calendar date parsed from STRING `created_at`. DATE type so it joins cleanly to `dim_dates.full_date` (also DATE) — BigQuery does not auto-coerce DATE↔TIMESTAMP. Mirrors PBI Power Query `Table.TransformColumnTypes({"created_at", type date})`.'
    definition: @sql DATE(TIMESTAMP({{#SOURCE.created_at}}));;
  }

  dimension first_name {
    label: 'First Name'
    type: 'text'
  }

  dimension last_name {
    label: 'Last Name'
    type: 'text'
  }

  dimension email {
    label: 'Email'
    type: 'text'
  }

  dimension company_name {
    label: 'Company Name'
    type: 'text'
  }

  dimension company_tax_number {
    label: 'Company Tax Number'
    type: 'text'
  }

  dimension delivery_country {
    label: 'Delivery Country'
    type: 'text'
  }

  dimension created_as_administrator_name {
    label: 'Administrator Name'
    type: 'text'
  }

  dimension trafficid {
    label: 'Traffic ID'
    type: 'text'
    definition: @sql {{#SOURCE.`trafficId`}};;
  }

  dimension price_quote_confirmation_time {
    label: 'Price Quote Confirmation Time'
    type: 'number'
  }

  dimension price_quote_payment_time {
    label: 'Price Quote Payment Time'
    type: 'number'
  }

  dimension payment_reminder_sent {
    label: 'Payment Reminder Sent'
    type: 'text'
  }

  dimension order_properties_hashed {
    label: 'Order Properties Hash'
    type: 'text'
    hidden: true
  }

  dimension ordering {
    label: 'Order Ordering'
    type: 'number'
  }

  dimension country_state {
    label: 'Country / State'
    type: 'text'
  }

  dimension account_manager {
    label: 'Account Manager'
    type: 'text'
  }

  dimension account_manager_attribution_type {
    label: 'Account Manager Attribution Type'
    type: 'text'
  }

  dimension lead_type {
    label: 'Lead Type'
    type: 'text'
  }
}
